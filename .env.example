# Backend API URL (no trailing slash)
# Local: http://localhost:5000 (must match backend PORT; leave empty in dev to use Vite /api proxy below)
# Production: your API URL, e.g. https://api.yourdomain.com
# VITE_API_URL=http://localhost:5000

# Vite dev only: proxy /api to this URL (default http://localhost:5000). Override if API runs on another port.
# VITE_DEV_PROXY_API=http://localhost:5000
